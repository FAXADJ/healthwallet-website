# Netlify. Apple and Android fetch these to decide whether links may open the
# app. Both must be served as JSON, over HTTPS, with no redirect.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
