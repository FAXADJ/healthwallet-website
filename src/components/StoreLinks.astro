---
import { appConfig, isConfiguredUrl } from '../config/app';
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const stores = [
  { label: 'Download on the App Store', eyebrow: 'Available for', name: 'App Store', url: appConfig.appStoreUrl },
  { label: 'Get it on Google Play', eyebrow: 'Available for', name: 'Google Play', url: appConfig.googlePlayUrl },
];
---
<div class:list={['store-links', { compact }]}>
  {stores.map((store) => isConfiguredUrl(store.url) ? (
    <a class="store-button" href={store.url} target="_blank" rel="noopener noreferrer" aria-label={store.label}>
      <span class="store-icon" aria-hidden="true">↓</span>
      <span><small>{store.eyebrow}</small><strong>{store.name}</strong></span>
    </a>
  ) : (
    <span class="store-button unavailable" aria-label={`${store.name} link coming soon`}>
      <span class="store-icon" aria-hidden="true">↓</span>
      <span><small>Link coming soon</small><strong>{store.name}</strong></span>
    </span>
  ))}
</div>
