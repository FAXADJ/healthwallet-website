---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoreLinks from '../components/StoreLinks.astro';
import PhonePreview from '../components/PhonePreview.astro';
import { appConfig } from '../config/app';

const features = [
  { icon: '✚', title: 'A medical summary you can reach', body: 'Keep your blood type, allergies, medications, conditions, emergency contact, and medical history together in your profile.' },
  { icon: '▦', title: 'Share on your terms', body: 'Show your personal QR code to connect with a doctor or coach, and export a medical record PDF when you choose.' },
  { icon: '⌖', title: 'Find care nearby', body: 'Explore doctors, hospitals, and pharmacies on the map. View available provider details and request appointments with participating doctors.' },
  { icon: '▤', title: 'Keep important documents', body: 'Add photos of medical documents and receipts. Text recognition checks documents on your device before upload.' },
  { icon: '◉', title: 'Follow fitness progress', body: 'View your body measurements, progress, and workout or nutrition plans when you are working with a coach.' },
  { icon: '◌', title: 'Stay connected', body: 'Use private chat with linked providers and see in-app updates about your care activity.' },
];
---
<BaseLayout title={`${appConfig.appName} — ${appConfig.tagline}`} description={appConfig.description}>
  <section class="hero section-pad">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="eyebrow"><span class="eyebrow-mark" aria-hidden="true">✚</span> Your personal health companion</div>
        <h1>Health information that travels <em>with you.</em></h1>
        <p class="hero-lead">Your medical summary, key documents, and a way to find care nearby — together in one app built for the Kurdistan Region of Iraq.</p>
        <StoreLinks />
        <p class="store-note">Store links will be added when the listings are live.</p>
        <div class="hero-proof"><span>English</span><span>العربية</span><span>کوردی</span><span class="separator" aria-hidden="true"></span><span>iOS & Android</span></div>
      </div>
      <div class="hero-visual">
        <div class="hero-orbit orbit-one" aria-hidden="true"></div>
        <div class="hero-orbit orbit-two" aria-hidden="true"></div>
        <div class="visual-label label-top"><span aria-hidden="true">✚</span> Your health profile</div>
        <PhonePreview file="profile.png" label="Your profile" note="Medical summary and emergency details" featured />
        <div class="visual-label label-bottom"><span aria-hidden="true">⌖</span> Care near you</div>
      </div>
    </div>
  </section>

  <section class="intro-strip" id="about">
    <div class="container intro-grid">
      <div><span class="section-kicker">About HealthWallet</span><h2>Less searching.<br /><em>More clarity.</em></h2></div>
      <div><p>Health details can end up scattered across forms, photos, and conversations. HealthWallet brings the information you choose to save into one account, so it is easier to find, update, and share when needed.</p><p>It is designed for patients and members, with separate workflows for participating doctors and coaches. The app also helps people discover nearby care and manage appointments.</p></div>
    </div>
  </section>

  <section class="section-pad features-section" id="features">
    <div class="container">
      <div class="section-heading"><div><span class="section-kicker">What you can do</span><h2>Useful tools for everyday health.</h2></div><p>From your own medical summary to local care and connected coaching.</p></div>
      <div class="feature-grid">
        {features.map((feature, index) => <article class:list={['feature-card', { 'feature-card-accent': index === 0 }]}>
          <span class="feature-icon" aria-hidden="true">{feature.icon}</span>
          <h3>{feature.title}</h3><p>{feature.body}</p>
        </article>)}
      </div>
    </div>
  </section>

  <section class="preview-section section-pad" id="preview">
    <div class="container">
      <div class="section-heading centered"><span class="section-kicker">Inside the app</span><h2>A closer look at HealthWallet.</h2><p>These frames are reserved for real app captures. Add the screenshots listed in the README before publishing promotional previews.</p></div>
      <div class="preview-grid">
        <PhonePreview file="profile.png" label="Profile" note="Personal and medical details" />
        <PhonePreview file="map.png" label="Care map" note="Doctors, hospitals, and pharmacies" />
        <PhonePreview file="fitness.png" label="Fitness" note="Plans and progress with a coach" />
      </div>
    </div>
  </section>

  <section class="why-section section-pad">
    <div class="container why-grid">
      <div class="why-image"><img src="/images/feature-graphic.png" alt="HealthWallet promotional graphic with the app icon and the words Your health, simplified" loading="lazy" width="1024" height="500" /></div>
      <div><span class="section-kicker">Built around choice</span><h2>Keep the details that matter. Share when you decide.</h2><p>You decide what to add to your profile, when to use location, and when to show your QR code or send a record. HealthWallet is an information organizer and directory, not a source of diagnosis or emergency care.</p><a class="text-link" href="/privacy">Read how the app handles data <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="download-section section-pad" id="download"><div class="container download-inner"><div><span class="section-kicker">HealthWallet for mobile</span><h2>Your health information, close at hand.</h2><p>Get ready to keep your medical summary and care connections in one place.</p></div><StoreLinks /></div></section>
</BaseLayout>
